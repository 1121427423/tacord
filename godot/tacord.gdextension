[configuration]

entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.7
reloadable = true

[libraries]

linux.x86_64 = "res://../gdext/target/release/libtacord_gdext.so"
macos.arm64 = "res://../gdext/target/release/libtacord_gdext.dylib"
windows.x86_64 = "res://../gdext/target/release/tacord_gdext.dll"
